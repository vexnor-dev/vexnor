{
   "name": "vexnor-root",
   "version": "1.0.0",
   "description": "",
   "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
   "type": "module",
   "author": "Adrian Topala",
   "license": "Apache-2.0",
   "repository": "https://github.com/vexnor-dev/vexnor",
   "engines": {
      "node": ">=22.22.3",
      "pnpm": ">=11.0.0"
   },
   "scripts": {
      "preinstall": "npx only-allow pnpm",
      "db-migrate": "run-s 'db-migrate:*'",
      "db-migrate:postgres": "env-cmd --no-override -x -r ./env-dev.json -e postgres postgrator --username \\$POSTGRES_USER --password \\$POSTGRES_PASSWORD --config @db-postgres/migrate-local.json",
      "db-migrate:sqlite3": "postgrator --config @db-sqlite3/migrate-local.json",
      "db-migrate:mssql": "env-cmd --no-override -x -r ./env-dev.json -e mssql postgrator --username \\$MSSQL_USER --password \\$MSSQL_PASSWORD --config @db-mssql/migrate-local.json",
      "db-seed:mongodb": "env-cmd --no-override -x -r ./env-dev.json -e mongodb npx tsx @db-mongodb/seed.ts",
      "clean:1-build": "pnpm -r --parallel exec rimraf dist deploy tsconfig.tsbuildinfo",
      "clean:1-lock-file": "pnpm exec rimraf pnpm-lock.yaml",
      "clean:1-coverage": "pnpm -r --parallel exec rimraf coverage",
      "clean:1-dependencies-r": "pnpm -r --parallel exec rimraf node_modules",
      "clean:1-dependencies-w": "pnpm exec rimraf node_modules",
      "clean:1-test": "pnpm -r --parallel exec rimraf dist deploy tsconfig.tsbuildinfo",
      "clean:11-testing-r": "pnpm exec rimraf coverage",
      "clean:11-testing-w": "pnpm -r --parallel exec rimraf coverage",
      "clean-all": "run-s 'clean:1-*'",
      "lint": "pnpm exec eslint . --ext .ts,.tsx,.js,.jsx",
      "format": "prettier --write \"./packages/**/*.{js,ts,jsx,tsx,json,md,yml,yaml}\"",
      "build": "run-s 'build:*'",
      "build:0-clean": "pnpm -r --parallel exec rimraf tsconfig.tsbuildinfo",
      "build:1-core": "pnpm --filter './packages/*' run build",
      "build:2-install": "pnpm install --frozen-lockfile",
      "build:3-libraries": "pnpm -r --filter './plugins/*' --filter './orms/*' run build",
      "build:5-rest": "pnpm -r --workspace-concurrency=1 --filter='!@vexnor/core' --filter='!./plugins/*' --filter='!./orms/*' run build",
      "test": "vitest --coverage run",
      "stack:dotnet:build": "dotnet build stacks/dotnet",
      "stack:dotnet:test": "dotnet test stacks/dotnet",
      "stack:dotnet:coverage": "dotnet test stacks/dotnet --collect:\"XPlat Code Coverage\"",
      "stack:golang:build": "cd stacks/golang && go build ./...",
      "stack:golang:test": "cd stacks/golang && go test ./vexnor/ -count=1",
      "stack:golang:coverage": "cd stacks/golang && go test ./vexnor/ -coverprofile=coverage.out -count=1 && go tool cover -func=coverage.out | tail -1",
      "stacks:build": "run-p 'stacks:*:build'",
      "stacks:test": "run-p 'stacks:*:test'"
   },
   "devDependencies": {
      "@eslint/js": "^9.39.4",
      "@types/node": "^22.19.21",
      "@vexnor/core": "workspace:^",
      "@vitest/coverage-v8": "^4.1.8",
      "add": "^2.0.6",
      "copyfiles": "^2.4.1",
      "deepmerge": "^4.3.1",
      "env-cmd": "^10.1.0",
      "eslint": "^9.39.4",
      "eslint-config-prettier": "^9.1.2",
      "eslint-plugin-import": "^2.32.0",
      "eslint-plugin-prettier": "^5.5.6",
      "eslint-plugin-simple-import-sort": "^12.1.1",
      "eslint-plugin-unused-imports": "^4.4.1",
      "npm-run-all": "^4.1.5",
      "pg": "^8.21.0",
      "pino-pretty": "^13.1.3",
      "postgrator-cli": "^9.1.0",
      "prettier": "^3.8.4",
      "replace-in-file": "^8.4.0",
      "rimraf": "^6.1.3",
      "sqlite3": "^5.1.7",
      "typescript": "7.0.2",
      "typescript-eslint": "^8.63.0",
      "vite": "^8.0.16",
      "vitest": "^4.1.8"
   },
   "private": true
}
