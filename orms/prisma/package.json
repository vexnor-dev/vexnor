{
  "name": "@vexnor/prisma",
  "version": "1.0.0-beta.3",
  "description": "Prisma adaptor for Vexnor — convert Prisma DMMF models to Vexnor runtime tables and bring them into Vexnor's typesafe, AI-native SQL framework.",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "keywords": [
    "vexnor",
    "prisma",
    "adaptor",
    "sql"
  ],
  "author": "Adrian Topala",
  "license": "Apache-2.0",
  "repository": "https://github.com/vexnor-dev/vexnor",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "codegen:prisma:v6-client": "node ./scripts/codegen-prisma-v6-isolated.mjs --schema src/__tests__/fixtures-v6-client/schema.prisma --config src/__tests__/prisma.config.ts",
    "codegen:prisma:v6-client-js": "node ./scripts/codegen-prisma-v6-isolated.mjs --schema src/__tests__/fixtures-v6-client-js/schema.prisma",
    "codegen:prisma:v7-client": "pnpm dlx --package=prisma@7.9.1 --package=@prisma/client@7.9.1 prisma generate --schema src/__tests__/fixtures-v7-client/schema.prisma --config src/__tests__/prisma.config.ts",
    "codegen:prisma:v7-client-js": "pnpm dlx --package=prisma@7.9.1 --package=@prisma/client@7.9.1 prisma generate --schema src/__tests__/fixtures-v7-client-js/schema.prisma",
    "codegen:prisma": "run-s 'codegen:prisma:*'",
    "prebuild": "(test -d src/__tests__/fixtures-v6-client/generated && test -d src/__tests__/fixtures-v6-client-js/generated && test -d src/__tests__/fixtures-v7-client/generated && test -d src/__tests__/fixtures-v7-client-js/generated) || run-s 'codegen:prisma'",
    "build": "tsc -b",
    "build:1-tsc": "tsc -b",
    "pretest": "run-s 'build'",
    "test": "vitest --coverage run",
    "test:watch": "vitest --watch",
    "test:run": "vitest run"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@prisma/internals": "^7.9.1",
    "@vexnor/core": "workspace:^"
  },
  "devDependencies": {
    "@prisma/client": "7.9.1",
    "@vitest/coverage-v8": "^4.1.5",
    "npm-run-all": "^4.1.5",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "changelog": "https://github.com/vexnor-dev/vexnor/releases"
}
