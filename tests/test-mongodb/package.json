{
   "name": "@vexnor/test-mongodb",
   "version": "1.0.0-beta.1",
   "description": "Integration tests for @vexnor/mongodb",
   "type": "module",
   "private": true,
   "author": "Adrian Topala",
   "license": "Apache-2.0",
   "scripts": {
      "build:dependencies": "pnpm --filter='@vexnor/core' --filter='@vexnor/mongodb' run build",
      "prebuild": "run-s 'build:dependencies'",
      "build": "tsc -b",
      "pretest": "run-s 'build'",
      "test": "vitest --coverage run",
      "test:watch": "vitest --watch",
      "test:run": "vitest run"
   },
   "dependencies": {
      "@vexnor/core": "workspace:*",
      "@vexnor/mongodb": "workspace:*",
      "mongodb": "^6.16.0"
   },
   "devDependencies": {
      "@vitest/coverage-v8": "^4.1.8",
      "npm-run-all": "^4.1.5",
      "typescript": "^7.0.2",
      "vite-tsconfig-paths": "^6.1.1",
      "vitest": "^4.1.8"
   }
}
