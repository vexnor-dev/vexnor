{
  "name": "@vexnor/duckdb",
  "version": "1.0.0-beta.3",
  "description": "DuckDB plugin for Vexnor — the typesafe, AI-native SQL framework. Schema introspection, typed execution, and the MCP agent surface for DuckDB via the official Node.js client.",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#src/duckdb-execution.js": {
      "browser": "./dist/duckdb-execution.browser.js",
      "default": "./dist/duckdb-execution.js"
    },
    "#src/*": "./dist/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "keywords": [
    "vexnor-plugin",
    "@vexnor/duckdb",
    "vexnor",
    "duckdb",
    "analytics",
    "olap",
    "sql",
    "plugin",
    "ai",
    "mcp"
  ],
  "author": "Adrian Topala",
  "license": "Apache-2.0",
  "repository": "https://github.com/vexnor-dev/vexnor",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.browser.js",
    "./dist/duckdb-augment.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -b",
    "pretest": "run-s build",
    "test": "vitest --coverage run",
    "test:watch": "vitest --watch",
    "test:run": "vitest run"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@vexnor/core": "workspace:^"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.5-r.3",
    "@vitest/coverage-v8": "^4.1.8",
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@duckdb/node-api": ">=1.5.5-r.3 <2"
  },
  "changelog": "https://github.com/vexnor-dev/vexnor/releases"
}
