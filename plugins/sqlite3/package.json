{
  "name": "@vexnor/sqlite3",
  "version": "1.0.0-beta.3",
  "description": "SQLite plugin for Vexnor — the typesafe, AI-native SQL framework. Schema introspection, typed execution, and the MCP agent surface for SQLite via better-sqlite3.",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#src/*": "./dist/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "keywords": [
    "vexnor",
    "sqlite3",
    "better-sqlite3",
    "sql",
    "plugin",
    "ai",
    "mcp"
  ],
  "author": "Adrian Topala",
  "license": "Apache-2.0",
  "repository": "https://github.com/vexnor-dev/vexnor",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.browser.js",
    "./dist/@vexnor/sqlite3.js",
    "./dist/sqlite3-augment.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -b",
    "pretest": "run-s 'build'",
    "test": "vitest --coverage run",
    "test:watch": "vitest --watch"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@vexnor/core": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^4.1.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "changelog": "https://github.com/vexnor-dev/vexnor/releases"
}
