{
   "name": "@vexnor/react-vite-ui",
   "version": "1.0.0",
   "private": true,
   "type": "module",
   "scripts": {
      "prepare-db": "pnpm --dir ../.. db-prepare:files",
      "precodegen": "run-s prepare-db build:dependencies",
      "build:dependencies": "pnpm --filter='@vexnor/core' --filter='@vexnor/postgres' --filter='@vexnor/mssql' --filter='@vexnor/sqlite3' --filter='@vexnor/duckdb' run build",
      "codegen:postgres": "env-cmd --no-override -x -r ../../env-dev.json -e postgres node ../../packages/core/cli.mjs codegen --plugin @vexnor/postgres --schema vexnor_dev  --camelCaseColumns --host \\$POSTGRES_HOST --port \\$POSTGRES_PORT --database \\$POSTGRES_DATABASE --user \\$POSTGRES_USER --password \\$POSTGRES_PASSWORD --outDir './shared/codegen/postgres' | pino-pretty",
      "codegen:mssql": "env-cmd --no-override -x -r ../../env-dev.json -e mssql node ../../packages/core/cli.mjs codegen --plugin @vexnor/mssql --schema vexnor_dev  --camelCaseColumns --host \\$MSSQL_HOST --port \\$MSSQL_PORT --database \\$MSSQL_DATABASE --user \\$MSSQL_USER --password \\$MSSQL_PASSWORD --outDir './shared/codegen/mssql' | pino-pretty",
      "codegen:sqlite3": "env-cmd --no-override -x -r ../../env-dev.json -e sqlite3 node ../../packages/core/cli.mjs codegen --plugin @vexnor/sqlite3 --schema main  --camelCaseColumns --uri \\$SQLITE_PATH --omit migration_vexnor --outDir './shared/codegen/sqlite3' | pino-pretty",
      "codegen:duckdb": "node ../../packages/core/cli.mjs codegen --plugin @vexnor/duckdb --schema main --camelCaseColumns --uri ../../@db-duckdb/vexnor-dev.duckdb --outDir ./shared/codegen/duckdb | pino-pretty",
      "codegen": "run-p 'codegen:*'",
      "serialize:postgres": "node ../../packages/core/cli.mjs serialize --input './shared/queries/postgres.ts' --output './manifests/postgres' --dialect postgresql",
      "serialize:mssql": "node ../../packages/core/cli.mjs serialize --input './shared/queries/mssql.ts' --output './manifests/mssql' --dialect transactsql",
      "serialize:sqlite3": "node ../../packages/core/cli.mjs serialize --input './shared/queries/sqlite3.ts' --output './manifests/sqlite3' --dialect sqlite",
      "serialize:duckdb": "node ../../packages/core/cli.mjs serialize --input './shared/queries/duckdb.ts' --output './manifests/duckdb' --dialect duckdb",
      "serialize": "run-p 'serialize:*'",
      "predev": "run-s 'serialize'",
      "dev": "vite",
      "dev:go": "run-p 'dev:go:backend' 'dev'",
      "dev:go:backend": "cd ../../stacks/golang && VEXNOR_MANIFEST_DIR=../../examples/react-vite-ui/manifests GO_EXAMPLE_PORT=5050 SQLITE_PATH=../../@db-sqlite3/vexnor-dev.sqlite DUCKDB_PATH=../../@db-duckdb/vexnor-dev.duckdb go run ./example",
      "dev:dotnet": "run-p 'dev:dotnet:backend' 'dev'",
      "dev:dotnet:backend": "VEXNOR_MANIFEST_DIR=../../examples/react-vite-ui/manifests ConnectionStrings__Sqlite3=../../@db-sqlite3/vexnor-dev.sqlite ConnectionStrings__DuckDB=../../@db-duckdb/vexnor-dev.duckdb dotnet run --project ../../stacks/dotnet/src/Vexnor.Example.Api",
      "build": "vite build",
      "build:tsc": "tsc --noEmit"
   },
   "dependencies": {
      "@tanstack/react-router": "^1.170.15",
      "@vexnor/core": "workspace:*",
      "@vexnor/duckdb": "workspace:*",
      "@vexnor/mssql": "workspace:*",
      "@vexnor/postgres": "workspace:*",
      "@vexnor/sqlite3": "workspace:*",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "react-error-boundary": "^6.1.2"
   },
   "devDependencies": {
      "@duckdb/node-api": "1.5.5-r.3",
      "@testing-library/react": "^16.3.2",
      "@testing-library/user-event": "^14.6.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^4.7.0",
      "env-cmd": "^10.1.0",
      "jsdom": "^25.0.1",
      "npm-run-all2": "^7.0.0",
      "pino-pretty": "^13.0.0",
      "typescript": "^7.0.2",
      "vite": "^8.0.16",
      "vite-tsconfig-paths": "^6.1.1",
      "vitest": "^4.1.8"
   }
}
