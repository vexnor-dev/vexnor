{
   "extends": "../../tsconfig.json",
   "compilerOptions": {
      "rootDir": ".",
      "outDir": "dist",
      "types": [
         "node"
      ],
      "paths": {
         "#src/*": [
            "./server/src/*"
         ],
         "#shared/*": [
            "./shared/*"
         ]
      }
   },
   "include": [
      "server"
   ],
   "references": [{
      "path": "../../packages/vexnor"
   }, {
      "path": "../../plugins/postgres"
   },{
      "path": "../../plugins/mssql"
   },{
      "path": "../../plugins/sqlite3"
   }]
}
